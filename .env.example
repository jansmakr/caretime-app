# ─────────────────────────────────────────────────────────────
# CareTime — 1단계(UI)에서는 아무 값도 필요하지 않습니다.
# 아래 항목은 2단계 이후 연동 지점을 미리 표시해 둔 것입니다.
# 값이 비어 있으면 앱은 Mock 데이터로 동작합니다. (README 「Mock 정책」 참고)
# ─────────────────────────────────────────────────────────────

# 2단계: Supabase — 둘 다 채우면 병원 상세·검색·/partner 가 Supabase 로 동작합니다.
# 브라우저에 노출되는 공개 키입니다. 쓰기 권한은 RLS 가 막습니다. (README 「2단계」)
# 값은 .env.local(로컬)·Vercel 환경변수(배포)에만 넣고 커밋하지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role 키는 앱에서 쓰지 않습니다. 브라우저 번들·NEXT_PUBLIC_ 접두사에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 5단계: 카카오 로그인 (작성 권한용. 읽기는 비회원 허용)
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 8단계: 공공데이터포털 (배치 동기화 전용 — 사용자 요청마다 호출하지 않음)
# 개발계정 한도가 낮으므로 서버 배치 + DB 캐시가 전제입니다.
DATA_GO_KR_SERVICE_KEY=

# 8단계: 지도. adapter 뒤에 있으므로 provider 교체 가능.
NEXT_PUBLIC_MAP_PROVIDER=kakao
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_NAVER_MAP_KEY=
